# VCB settings. The settings window (VCB Settings.bat) writes `.env` for you,
# so most people never need to edit this by hand. To configure manually, copy
# this file to `.env` (same folder as main.py) and uncomment what you want to
# change; anything left commented out uses the default in vcb/config.py.
# `.env` is git-ignored, so it's safe for a real API key. Command-line flags
# (`python main.py --help`) always override whatever is set here.

# --- LLM backend: ollama (default, local) | cloud | llama_cpp (advanced) -----
# VCB_BACKEND=ollama
# VCB_OLLAMA_MODEL=llama3.1:8b                  # any Ollama tag; the settings window recommends one that fits your GPU
# VCB_OLLAMA_NUM_CTX=8192                       # context VCB runs Ollama models with (Ollama's default can use far more GPU memory)
# VCB_VRAM_RESERVE_GB=2                         # GPU memory the settings window keeps free for other apps
# VCB_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1 # where Ollama's API is listening
# VCB_OLLAMA_AUTO_LAUNCH=false                  # true = always start/stop `ollama serve` with VCB
# VCB_CLOUD_BASE_URL=https://api.openai.com/v1  # any OpenAI-compatible API (Gemini, OpenRouter, Groq, ...)
# VCB_CLOUD_API_KEY=sk-...                      # your provider's secret key
# VCB_CLOUD_MODEL=gpt-4o-mini
# VCB_CLOUD_REASONING_EFFORT=minimal            # thinking models: none|minimal|low|medium|high (lower = faster)
# VCB_TOOL_MODE=auto                            # auto | native (API function calling) | json (VCB's text protocol)
#   Google Gemini free tier: VCB_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VCB_CLOUD_MODEL=gemini-3.5-flash-lite, VCB_CLOUD_REASONING_EFFORT=minimal (key: aistudio.google.com/api-keys)
# VCB_ACTIVE_MODEL=qwen3-4b                     # llama_cpp: preset name (user/models.json) or a .gguf path

# --- Voice --------------------------------------------------------------------
# VCB_TTS_ENGINE=chatterbox-turbo               # chatterbox-turbo | indextts (emotional; installed on next start) | kokoro (| xtts | orpheus | csm with extras)
# VCB_VOICE_WAV=user\voice.wav                  # voice sample to clone (missing = built-in voice)
# VCB_KOKORO_VOICE=af_heart                     # kokoro preset voice
# VCB_INDEXTTS_GPUS=auto                        # indextts: auto (one copy per GPU with room) | 1 | 0,1

# --- Persona ------------------------------------------------------------------
# VCB_ACTIVE_PROMPT=assistant                   # file in prompts/ or user/prompts/ (no .txt)
# VCB_USER_NAME=Alex                            # how VCB's own nudges refer to you
# VCB_TIMEZONE=Europe/Berlin                    # IANA time zone; unset = this PC's (incl. daylight saving)

# --- Audio devices (name or index; unset = system default) -------------------
# VCB_INPUT_DEVICE=Microphone (USB Audio)
# VCB_OUTPUT_DEVICE=Speakers (Realtek(R) Audio)

# --- GPUs (nvidia-smi indices) --------------------------------------------------
# Unset = VCB uses every GPU: after the LLM loads, speech recognition and the
# voice are each placed on the GPU with the most free memory (like Ollama does).
# VCB_CUDA_DEVICES=1                            # restrict all of VCB's GPU work to these GPUs
# VCB_LLM_CUDA_DEVICES=1                        # llama-server only (llama_cpp backend)

# --- Feature toggles -----------------------------------------------------------
# VCB_MEMORY_ENABLED=true                       # long-term memory (recall + storage)
# VCB_MEMORY_EPHEMERAL=false                    # true = recall works, nothing saved to disk
# VCB_AVATAR_ENABLED=false                      # stream audio/state to the Unreal avatar app
# VCB_AVATAR_LOCAL_AUDIO=false                  # with avatar on, also play audio on this PC
# VCB_AI_LED=false                              # assistant leads: greets first, speaks up when idle

# --- Logging -------------------------------------------------------------------
# VCB_LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
